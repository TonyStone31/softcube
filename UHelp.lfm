object frmHelp: TfrmHelp
  Left = 0
  Height = 700
  Top = 0
  Width = 680
  BorderStyle = bsSizeToolWin
  Caption = 'SoftCube Help'
  Position = poMainFormCenter
  LCLVersion = '4.99.0.0'
  object memHelp: TMemo
    Left = 0
    Height = 700
    Top = 0
    Width = 680
    Align = alClient
    Color = 2105376
    Font.Color = 13434726
    Font.Height = -13
    Font.Name = 'Monospace'
    Font.Pitch = fpFixed
    Lines.Strings = (
      ''
      '   ____         __ _    ____      _'
      '  / ___|  ___  / _| |_ / ___|   _| |__   ___'
      '  \___ \ / _ \| |_| __| |  | | | | ''_ \ / _ \'
      '   ___) | (_) |  _| |_| |__| |_| | |_) |  __/'
      '  |____/ \___/|_|  \__|\____\__,_|_.__/ \___|'
      ''
      '  NxN Rubik''s Cube Simulator & Solver'
      '  ======================================'
      ''
      '  Supports 2x2 and up. Solved a 50x50 in ~9 hours'
      '  (2330 moves).'
      '  Uses Kociemba''s reduction method for 4x4+ and'
      '  min2phase for the final 3x3 reduction solve.'
      ''
      ''
      '  -----------------------------------------------'
      '  CUBE SIZES'
      '  -----------------------------------------------'
      ''
      '  Use the size spinner at the top of the window to'
      '  select any cube size. Changing size resets the cube.'
      ''
      '    2x2          Pocket cube'
      '    3x3          Standard Rubik''s Cube'
      '    4x4 - 6x6    Large cubes'
      '    7x7+         Very large cubes. 7x7 introduces'
      '                 oblique center pieces (pieces not on'
      '                 the plus or x-cross pattern). These'
      '                 require an additional ~10 GB table'
      '                 generated on first run.'
      ''
      ''
      '  -----------------------------------------------'
      '  3D VIEW CONTROLS'
      '  -----------------------------------------------'
      ''
      '  Mouse drag            Rotate the 3D view'
      '  Mouse wheel           Zoom in/out'
      '  Reset View button     Return to default angle'
      ''
      ''
      '  -----------------------------------------------'
      '  KEYBOARD MODE'
      '  -----------------------------------------------'
      ''
      '  Toggle the Keyboard Mode checkbox to enable.'
      ''
      '  Cube Rotation:'
      '    A / D          Rotate cube left / right'
      '    W              Flip cube up'
      '    S              Peek under the cube'
      ''
      '  Face Selection:'
      '    Arrow keys     Move selection across faces'
      '    Marching ants  Highlight the selected face'
      ''
      '  Turning:'
      '    Space          CW rotation of selected face'
      '    Shift+Space    CCW rotation of selected face'
      ''
      '  Slice Selection (4x4+):'
      '    [ / ]          Select inner slice layer'
      '    Shift + [ / ]  Wide moves (multiple layers)'
      ''
      ''
      '  -----------------------------------------------'
      '  FACE BUTTONS'
      '  -----------------------------------------------'
      ''
      '  Click the labeled buttons around the cube drawing'
      '  to rotate individual faces. Left-click for CW,'
      '  right-click or Shift+click for CCW.'
      ''
      ''
      '  -----------------------------------------------'
      '  MOVE NOTATION (Singmaster)'
      '  -----------------------------------------------'
      ''
      '  Type moves in the Commands box:'
      ''
      '    U  D  R  L  F  B    Face moves (clockwise)'
      '    U'' D'' R'' ...        Counter-clockwise'
      '    U2 D2 R2 ...        Half turns (180 deg)'
      ''
      '  Inner slices (4x4+):'
      '    2R  2U  2F ...      2nd slice from that face'
      '    3R  3U  3F ...      3rd slice (6x6+)'
      ''
      '  Wide moves:'
      '    Uw  Dw  Rw ...      2-layer wide moves'
      '    3Uw 3Rw ...         3-layer wide moves (5x5+)'
      ''
      '  Special:'
      '    M  E  S             Middle slice moves'
      '    x  y  z             Whole cube rotations'
      ''
      '  Buttons:'
      '    Execute              Run all moves at once'
      '    Step Fwd / Back      One move at a time'
      '    Execute Until Solved Repeat until solved'
      ''
      ''
      '  -----------------------------------------------'
      '  SCRAMBLE'
      '  -----------------------------------------------'
      ''
      '  Click "Scramble" to apply a random scramble.'
      '  A dialog asks how many random moves to apply.'
      '  The move count is remembered between sessions.'
      ''
      ''
      '  -----------------------------------------------'
      '  SOLVING'
      '  -----------------------------------------------'
      ''
      '  Click "Solve" to find a solution. The solver runs'
      '  as an external process so you can cancel anytime.'
      ''
      '  For 3x3:'
      '    Uses the built-in min2phase two-phase algorithm.'
      '    Finds near-optimal solutions almost instantly.'
      ''
      '  For 4x4+:'
      '    Uses a 6-phase Kociemba reduction method:'
      ''
      '    Phase 1  Solve UD center pieces'
      '    Phase 2  Solve FB center pieces'
      '    Phase 3  Solve RLFB center pieces'
      '    Phase 4  Fully solve UD center pieces'
      '    Phase 5  Pair all wing edges (freeslice method)'
      '    Phase 6  Solve as a 3x3 (min2phase)'
      ''
      '  The solver prints each phase as it completes, so'
      '  you can see exactly where it is in the process.'
      ''
      ''
      '  -----------------------------------------------'
      '  SOLVER OUTPUT MESSAGES'
      '  -----------------------------------------------'
      ''
      '  The Terminal Output window shows real-time solver'
      '  progress. Here is what each message means:'
      ''
      ''
      '  NxN Solver v0.9.1 (build 5) - solving 8x8 cube'
      '  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~'
      '  Version and build number. Shown at startup so you'
      '  know which solver binary is running.'
      ''
      ''
      '  Phase 1: Loading UD center tables...'
      '  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~'
      '  Loading precomputed lookup tables from disk.'
      '  First run for 7x7+ generates large tables that'
      '  can take hours. After that they load in seconds.'
      ''
      ''
      '  Phase 1: Loading oblique table... 50%'
      '  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~'
      '  Loading the oblique orbit table. This only'
      '  appears for 7x7+ cubes because smaller cubes'
      '  (4x4-6x6) only have plus-cross and x-cross'
      '  center orbits — the oblique orbit first appears'
      '  at 7x7. The ~10 GB table takes about a minute'
      '  to load. Percentage updates show progress.'
      ''
      ''
      '  Phase 1: UD centers oblique orbit (2,3),'
      '           step 3/54, 45 moves, 13.9 s elapsed'
      '  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~'
      '  Progress during a long center-solving phase.'
      '  Shows which orbit pair is being solved, the'
      '  step number out of total steps, how many moves'
      '  found so far, and elapsed time. Updates every'
      '  5 seconds so you know the solver is alive.'
      ''
      ''
      '  PHASE: 1 UD centers - 41 moves in 6.8 s'
      '  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~'
      '  A phase completed! Shows the total move count'
      '  and time for that phase. You will see one of'
      '  these for each of the 6 phases.'
      ''
      ''
      '  Phase 5: Pairing 3 edge orbits'
      '            (67/72 slots need fixing)'
      '  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~'
      '  Edge pairing has started. Shows how many edge'
      '  orbits need pairing and how many individual'
      '  edge slots (out of the total) need work.'
      ''
      ''
      '  Phase 5: 45/72 edge slots paired (63%),'
      '           350 moves, 15.3 s elapsed'
      '           [horizontal FL orb 3/3, depth 4]'
      '  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~'
      '  Progress during edge pairing. Updates every'
      '  5 seconds. Shows:'
      '    - Paired slots / total slots (percentage)'
      '    - Total moves found so far'
      '    - Elapsed time for this phase'
      '    - What it is currently working on:'
      '      "horizontal FL" = pairing horizontal edges'
      '      "vertical" = fixing vertical edge mismatches'
      '      "orb 3/3" = which orbit out of total'
      '      "depth 4" = IDA* search depth (higher ='
      '        harder sub-problem, takes longer)'
      ''
      ''
      '  SOLUTION: 3x3 phase: 22 moves (target: 20)|...'
      '  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~'
      '  A complete solution was found! The solver keeps'
      '  searching for a shorter one. Each time it finds'
      '  fewer moves, it prints a new SOLUTION line.'
      ''
      '  If you cancel during this phase, the solver uses'
      '  the last SOLUTION found - so you always get a'
      '  valid answer even if you stop early.'
      ''
      '  "target: 20" means it will stop automatically'
      '  if it reaches 20 moves (set by Solve Quality).'
      '  "searching for <= 20" means it found a solution'
      '  but is still trying to beat 20 moves.'
      ''
      ''
      '  SEARCH: 3x3 phase: best 21 moves, depth 10...'
      '  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~'
      '  The 3x3 optimizer is exploring deeper in the'
      '  search tree. It has a 21-move solution and is'
      '  now checking if depth 10 can do better. Higher'
      '  depths take exponentially longer.'
      ''
      ''
      '  === 8x8 Solution in 12.5 s ==='
      '  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~'
      '  All done! Shows the cube size and total time'
      '  from start to finish.'
      ''
      ''
      '  VERIFY: Solution verified OK on 8x8'
      '  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~'
      '  The solver applied its own solution to a fresh'
      '  copy of the scrambled cube and confirmed every'
      '  face is solved. This is an automatic sanity'
      '  check - you should always see "OK".'
      ''
      ''
      '  -----------------------------------------------'
      '  CANCEL & BEST SOLUTION'
      '  -----------------------------------------------'
      ''
      '  You can click Cancel at any time during a solve.'
      ''
      '  - During phases 1-5: the solve stops and no'
      '    solution is returned (incomplete reduction).'
      ''
      '  - During phase 6 (3x3 optimization): if at least'
      '    one SOLUTION line has been printed, that full'
      '    solution is used. This is the best time to'
      '    cancel - you get a valid solution, just maybe'
      '    with a few extra moves.'
      ''
      ''
      '  -----------------------------------------------'
      '  TOOLS MENU'
      '  -----------------------------------------------'
      ''
      '  Solve Quality:'
      '    Fast       Target 23 moves, 5s limit (quick)'
      '    Balanced   Target 20 moves, 15s limit'
      '    Optimal    Target 18 moves, 60s limit (slow)'
      ''
      '    This only affects the 3x3 phase (phase 6).'
      '    Lower targets find shorter solutions but take'
      '    much longer to search.'
      ''
      '  Solver Timeout:'
      '    Set maximum total solve time (5 to 60 min).'
      '    "No Limit" disables the timeout entirely.'
      '    Use No Limit for very large cubes (20x20+)'
      '    that may take 30+ minutes to solve.'
      ''
      '  Animation Speed:'
      '    Controls how fast moves animate on screen.'
      ''
      '  Generate Tables:'
      '    Pre-generate solver lookup tables for the'
      '    current cube size. Required for 7x7+ before'
      '    first solve. Tables are cached on disk.'
      ''
      '  Table Status:'
      '    Shows which table files exist and their sizes.'
      ''
      '  Delete Tables:'
      '    Remove all cached solver tables to free disk'
      '    space. They will be regenerated on next solve.'
      ''
      ''
      '  -----------------------------------------------'
      '  STICKER EDITING'
      '  -----------------------------------------------'
      ''
      '  Right-click any sticker on the 2D or 3D cube'
      '  drawing to change its color manually. Use this'
      '  to enter a real cube state for solving. Make'
      '  sure every color appears exactly N*N times'
      '  (e.g. 9 of each for a 3x3).'
      ''
      ''
      '  -----------------------------------------------'
      '  WEBCAM SCANNING'
      '  -----------------------------------------------'
      ''
      '  EXPERIMENTAL - this feature is still a work in'
      '  progress and may not produce reliable results.'
      ''
      '  Click "Scan Webcam" to capture cube colors from'
      '  your camera. Hold each face centered in the grid'
      '  overlay. Currently limited to cubes up to 5x5.'
      ''
      ''
      '  -----------------------------------------------'
      '  TIPS & TRICKS'
      '  -----------------------------------------------'
      ''
      '  - Animation speed is set from the Tools menu'
      '  - The Terminal window shows all solver output'
      '  - For big cubes (14x14+), set timeout to No Limit'
      '  - First solve on a new size is slower (table init)'
      '  - Subsequent solves of the same size are fast'
      '  - You can solve, scramble, and re-solve to see'
      '    different solution paths'
      ''
      ''
      '  -----------------------------------------------'
      '  PERFORMANCE GUIDE'
      '  -----------------------------------------------'
      ''
      '  Approximate solve times (varies by scramble'
      '  and hardware):'
      ''
      '    3x3           Instant'
      '    4x4 - 5x5     5 - 30 seconds'
      '    6x6            15 - 60 seconds'
      '    7x7            30 seconds - 3 minutes'
      '    8x8 - 10x10   1 - 10 minutes'
      '    14x14          5 - 20 minutes'
      '    20x20          ~11 minutes (actual result)'
      '    50x50          ~9 hours (actual result)'
      ''
      '  The solver always finds a solution. It never'
      '  gives up. Set timeout to "No Limit" for very'
      '  large cubes and be patient.'
      ''
      '  Phase 1 (UD centers) is typically the slowest'
      '  phase for large cubes. Phase 5 (edge pairing)'
      '  can also take several minutes on 14x14+.'
      '  Phase 6 (3x3 optimization) depends on your'
      '  Solve Quality setting.'
      ''
      ''
    )
    ReadOnly = True
    ScrollBars = ssAutoBoth
    TabOrder = 0
  end
end
